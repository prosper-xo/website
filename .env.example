# ==============================================================================
# Prosper XO - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development
# Set these in Netlify Dashboard -> Site Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Analytics & Tracking
# ------------------------------------------------------------------------------

# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com -> Admin -> Data Streams
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-E00NWTHP4Q

# ------------------------------------------------------------------------------
# Site Configuration
# ------------------------------------------------------------------------------

# Site URL (used for metadata, canonical URLs, sitemaps)
# Production: https://prosperxo.com
# Staging: https://staging--prosper-xo.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site Name (used in metadata)
NEXT_PUBLIC_SITE_NAME=Prosper XO

# ------------------------------------------------------------------------------
# CMS Configuration (Decap CMS)
# ------------------------------------------------------------------------------

# Netlify Identity is configured in cms/config.yml
# No environment variables needed for basic setup
# Advanced settings can be added here if needed

# ------------------------------------------------------------------------------
# Third-Party Integrations
# ------------------------------------------------------------------------------

# Add API keys for any third-party services here
# Examples:
# NEXT_PUBLIC_MAILCHIMP_API_KEY=
# NEXT_PUBLIC_SENDGRID_API_KEY=

# ------------------------------------------------------------------------------
# Feature Flags (Optional)
# ------------------------------------------------------------------------------

# Enable/disable features for testing
# NEXT_PUBLIC_ENABLE_BLOG=true
# NEXT_PUBLIC_ENABLE_EVENTS=true
# NEXT_PUBLIC_MAINTENANCE_MODE=false

# ------------------------------------------------------------------------------
# Development Only
# ------------------------------------------------------------------------------

# Debug mode (never set to true in production!)
# NEXT_PUBLIC_DEBUG=false

# ==============================================================================
# IMPORTANT NOTES:
# ==============================================================================
# 1. Variables starting with NEXT_PUBLIC_ are exposed to the browser
# 2. Never commit .env.local or any file containing real API keys
# 3. In Netlify, set these under: Site Settings > Environment Variables
# 4. Netlify Identity credentials are managed automatically by Netlify
# ==============================================================================